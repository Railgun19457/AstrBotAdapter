{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://railgun19457.github.io/astrbot-minecraft/log.schema.json",
  "$defs": {
    "log_query_request": {
      "type": "object",
      "required": ["max_lines"],
      "properties": {
        "tail_lines": { "type": "integer", "minimum": 1 },
        "since": { "type": "integer" },
        "until": { "type": "integer" },
        "level": { "type": "string" },
        "keyword": { "type": "string" },
        "max_lines": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "log_query_response": {
      "type": "object",
      "required": ["servers", "errors", "generated_at"],
      "properties": {
        "servers": { "type": "array" },
        "errors": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/aggregate_error" } },
        "generated_at": { "type": "integer" }
      },
      "additionalProperties": true
    }
  }
}
